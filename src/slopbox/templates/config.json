{
  "version": 1,
  "auto_read_compose_override": true,

  "profiles": {
    "default": "claude-python",
    "claude-python": {
      "pkgs": [
        "python314",
        "uv",
        "gnumake"
      ],
      "use_base_pkgs": true,
      "agent": "claude-code",
      "mounts": [
        "workdir",
        "git-ro"
      ],
      "proxy": {
        "enable": true,
        "allowlist": [
          "python3",
          "github"
        ]
      }
    }
  }
}
